<?xml version="1.0" encoding="UTF-8" ?>

<!-- 
FastDDS QoS Profiles Configuration

This file defines Quality of Service (QoS) profiles for FastDDS communication.
Customize these profiles based on your application requirements.
-->

<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    
    <!-- Transport Descriptors -->
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>UdpTransport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>SharedMemoryTransport</transport_id>
            <type>SHM</type>
        </transport_descriptor>
    </transport_descriptors>

    <!-- Domain Participant Profiles -->
    <participant_profiles>
        <participant_profile name="default_participant" is_default_profile="true">
            <participant>
                <rtps>
                    <useBuiltinTransports>true</useBuiltinTransports>
                    <builtin>
                        <metatrafficUnicastLocatorList>
                            <locator>
                                <udpv4>
                                    <address>239.255.0.1</address>
                                    <port>7400</port>
                                </udpv4>
                            </locator>
                        </metatrafficUnicastLocatorList>
                        <initialPeersList>
                            <locator>
                                <udpv4>
                                    <address>239.255.0.1</address>
                                    <port>7400</port>
                                </udpv4>
                            </locator>
                        </initialPeersList>
                    </builtin>
                </rtps>
            </participant>
        </participant_profile>

        <!-- High-performance profile for local communication -->
        <participant_profile name="local_high_performance">
            <participant>
                <rtps>
                    <useBuiltinTransports>true</useBuiltinTransports>
                    <builtin>
                        <metatrafficUnicastLocatorList>
                            <locator>
                                <udpv4>
                                    <address>127.0.0.1</address>
                                    <port>7401</port>
                                </udpv4>
                            </locator>
                        </metatrafficUnicastLocatorList>
                    </builtin>
                </rtps>
            </participant>
        </participant_profile>
    </participant_profiles>

    <!-- Publisher Profiles -->
    <publisher_profiles>
        <publisher_profile name="default_publisher" is_default_profile="true">
            <qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>10</depth>
                </history>
                <resource_limits>
                    <max_samples>100</max_samples>
                    <max_instances>1</max_instances>
                    <max_samples_per_instance>10</max_samples_per_instance>
                </resource_limits>
            </qos>
        </publisher_profile>

        <!-- Best-effort publisher for high-frequency data -->
        <publisher_profile name="best_effort_publisher">
            <qos>
                <reliability>
                    <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>5</depth>
                </history>
            </qos>
        </publisher_profile>
    </publisher_profiles>

    <!-- Subscriber Profiles -->
    <subscriber_profiles>
        <subscriber_profile name="default_subscriber" is_default_profile="true">
            <qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>10</depth>
                </history>
                <resource_limits>
                    <max_samples>100</max_samples>
                    <max_instances>1</max_instances>
                    <max_samples_per_instance>10</max_samples_per_instance>
                </resource_limits>
            </qos>
        </subscriber_profile>

        <!-- Transient local subscriber for late-joining -->
        <subscriber_profile name="transient_local_subscriber">
            <qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                </reliability>
                <durability>
                    <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>10</depth>
                </history>
            </qos>
        </subscriber_profile>
    </subscriber_profiles>

    <!-- Data Writer Profiles -->
    <data_writer_profiles>
        <data_writer_profile name="default_data_writer" is_default_profile="true">
            <qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>10</depth>
                </history>
            </qos>
        </data_writer_profile>
    </data_writer_profiles>

    <!-- Data Reader Profiles -->
    <data_reader_profiles>
        <data_reader_profile name="default_data_reader" is_default_profile="true">
            <qos>
                <reliability>
                    <kind>RELIABLE_RELIABILITY_QOS</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>10</depth>
                </history>
            </qos>
        </data_reader_profile>
    </data_reader_profiles>

</profiles>
